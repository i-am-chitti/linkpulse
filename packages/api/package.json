{
  "name": "@linkpulse/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "prisma generate && tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db:setup": "node scripts/setup-test-db.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "dev:worker": "tsx watch src/worker.ts",
    "start:worker": "node dist/worker.js"
  },
  "dependencies": {
    "@linkpulse/shared": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcrypt": "6.0.0",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "geoip-lite": "2.0.3",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "jsonwebtoken": "9.0.3",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "ua-parser-js": "2.0.10",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/bcrypt": "6.0.0",
    "@types/cookie-parser": "1.4.9",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/geoip-lite": "1.4.4",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "24.13.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "pino-pretty": "13.1.3",
    "prisma": "7.10.0",
    "supertest": "7.2.2",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
