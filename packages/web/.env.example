# Origin the browser calls for API requests. Inlined into the browser bundle
# at build time (NEXT_PUBLIC_* vars are not readable at container start), so
# this must be set before `next build`, not just before `next start`.
NEXT_PUBLIC_API_URL=http://localhost:4001

# Cloudflare Turnstile site key (public, unlike the API's TURNSTILE_SECRET_KEY).
# Blank hides the widget; set both halves together or neither.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
