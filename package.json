{
  "name": "linkpulse",
  "version": "0.1.0",
  "private": true,
  "description": "High-performance URL shortener with real-time analytics",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "test": "pnpm -r test",
    "typecheck": "pnpm --filter @linkpulse/shared build && pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:reset": "node scripts/verify.mjs reset",
    "verify:clean": "node scripts/verify.mjs clean",
    "verify:down": "node scripts/verify.mjs down"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0"
  }
}
