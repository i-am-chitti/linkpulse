{
  "name": "linkpulse",
  "version": "0.1.0",
  "private": true,
  "description": "High-performance URL shortener with real-time analytics",
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "test": "pnpm -r test",
    "typecheck": "pnpm --filter @linkpulse/shared build && pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "e2e:reset": "node scripts/e2e.mjs reset",
    "e2e:clean": "node scripts/e2e.mjs clean",
    "e2e:down": "node scripts/e2e.mjs down",
    "e2e:run": "node scripts/e2e.mjs run"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0"
  }
}
