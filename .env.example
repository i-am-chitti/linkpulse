# Copy to .env and adjust. Values below match docker-compose.yml, so running
# `docker compose up -d postgres redis` and `pnpm dev` works with no edits.

# ---- Runtime ----
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# ---- Host port mappings for docker compose ----
# Defaults avoid the standard ports so the stack coexists with other local
# services. Change these if they collide on your machine.
API_PORT=4001
POSTGRES_PORT=5433
REDIS_PORT=6381
WEB_PORT=3000

# ---- Postgres ----
# Uses the host mapping above; inside compose the API talks to postgres:5432.
DATABASE_URL=postgresql://linkpulse:linkpulse@localhost:5433/linkpulse
# Connections this instance may hold. Small on purpose: Postgres is only hit
# on a cache miss, and a big pool per instance multiplies as instances scale.
DATABASE_POOL_MAX=10

# ---- Redis ----
REDIS_URL=redis://localhost:6381

# ---- Auth ----
# Must be at least 32 characters: HS256 with a short secret is brute-forceable
# offline, and forging this secret forges any session.
#   openssl rand -hex 32
JWT_SECRET=replace-me-with-openssl-rand-hex-32-output-at-least-32-chars
# Access tokens are short-lived because nothing can revoke one before it expires.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# bcrypt cost factor; 12 is ~250ms per hash.
BCRYPT_ROUNDS=12

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_ANON_CREATE_PER_MINUTE=10
RATE_LIMIT_ANON_REDIRECT_PER_MINUTE=100
RATE_LIMIT_USER_API_PER_MINUTE=50
RATE_LIMIT_USER_REDIRECT_PER_MINUTE=500
# Not in the spec: shared per-IP budget for register/login/refresh.
RATE_LIMIT_AUTH_PER_MINUTE=20
# Authenticated link creation, per IP across every account that IP holds -
# accounts are free, so a per-user limit alone multiplies with registrations.
RATE_LIMIT_CREATE_PER_IP_PER_MINUTE=30
# Links one account may own at once; bounds table growth, not just rate.
MAX_LINKS_PER_USER=500

# ---- Click worker ----
# Clicks written per transaction; larger batches amortise the round trip.
CLICK_BATCH_SIZE=100
# Longest the worker blocks on an empty queue before looping.
CLICK_BLOCK_SECONDS=5
# Hard cap on queued clicks, so a stopped worker cannot push Redis to its
# maxmemory limit and start evicting the URL cache and rate-limit counters.
CLICK_QUEUE_MAX_LENGTH=100000
# How often the worker sweeps expired guest links and stale refresh tokens.
CLEANUP_INTERVAL_MINUTES=60

# ---- App ----
# Origin short links are served from; used to build shortUrl in API responses.
# Not BASE_URL: Vite reserves that name and overrides it under Vitest.
APP_BASE_URL=http://localhost:4001
# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:3000
# Where the OAuth callback sends the browser once a session is issued.
WEB_ORIGIN=http://localhost:3000

# ---- Security ----
# Comma-separated domains rejected on link create/edit (hostname or subdomain
# match). Defaults to Google's own documented Safe Browsing *test* domains,
# so the feature works out of the box; point this at a real feed for
# production.
URL_BLOCKLIST=malware.testing.google.test,testsafebrowsing.appspot.com

# ---- OAuth (optional) ----
# Leave both blank to disable a provider. Register an app with its callback
# URL set to ${APP_BASE_URL}/api/auth/oauth/github/callback (or .../google/callback):
#   GitHub: https://github.com/settings/developers
#   Google: https://console.cloud.google.com/apis/credentials
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
